# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Firebase Authentication (free tier: up to 50,000 monthly active users, no card required) ---
# Create a project at https://console.firebase.google.com, enable Authentication ->
# Sign-in method -> Email link (passwordless sign-in), then copy these values from
# Project settings -> General -> "Your apps" -> Web app (</> icon).
# These VITE_ values are safe to expose in the client bundle — Firebase's client
# config is a public identifier, not a secret. Real access control happens via
# Firebase's servers plus the server-side check below.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="my-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="my-project"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"

# --- Push notifications (Firebase Cloud Messaging) ---
# VITE_FIREBASE_MESSAGING_SENDER_ID: from the same Firebase web app config as above
# (Project settings -> General -> Your apps -> web app config -> "messagingSenderId").
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_MESSAGING_SENDER_ID"
# VITE_FIREBASE_VAPID_KEY: Firebase Console -> Project settings -> Cloud Messaging ->
# "Web configuration" -> Web Push certificates -> Generate key pair.
VITE_FIREBASE_VAPID_KEY="MY_VAPID_KEY"

# FIREBASE_SERVICE_ACCOUNT_KEY: Required on the SERVER ONLY, to verify that
# incoming requests carry a valid Firebase sign-in token before calling the
# (paid) Gemini API. Generate at Firebase Console -> Project settings ->
# Service accounts -> Generate new private key, then paste the ENTIRE
# downloaded JSON file content here as a single-line string. Never commit
# this value or expose it to the client — it is a secret.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# For push notifications to actually send, also enable Firestore in your
# Firebase project (Firebase Console -> Build -> Firestore Database ->
# Create database — any region, "production mode" is fine). No extra key
# needed: the service account above already has access to it.

# ALLOW_TEST_AUTH: Local development ONLY. When set to "true", requests can
# skip real Firebase sign-in by sending "Authorization: Bearer test" — handy
# for testing the API without a real account. NEVER set this in your real
# deployment (Cloud Run env vars, etc.) — leaving it unset (or "false") is
# what keeps this shortcut from working in production.
ALLOW_TEST_AUTH="false"

# CRON_SECRET: A random string you make up, used to protect the
# /api/notifications/run-check endpoint that triggers sending reminder
# pushes. Point a Cloud Scheduler job (or similar) at that URL every 5-15
# minutes with header "Authorization: Bearer <this value>". Generate one
# with e.g. `openssl rand -hex 32`.
CRON_SECRET="MY_RANDOM_CRON_SECRET"
