# Cloud Run env vars file — used with:
#   gcloud run deploy luma --source . --region us-central1 --allow-unauthenticated --env-vars-file env.yaml
#
# Fill in every value below (same values as your .env.local — see .env.example
# for where each one comes from), then run the deploy command above.
# This file will hold real secrets once filled in — it's already covered by
# .gitignore's "*.yaml" style rules aren't automatic, so make sure it's NOT
# committed to git (add "env.yaml" to .gitignore if it isn't already ignored).

GEMINI_API_KEY: "MY_GEMINI_API_KEY"
APP_URL: "https://REPLACE_AFTER_FIRST_DEPLOY.run.app"

VITE_FIREBASE_API_KEY: "MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN: "my-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID: "my-project"
VITE_FIREBASE_APP_ID: "MY_FIREBASE_APP_ID"
VITE_FIREBASE_MESSAGING_SENDER_ID: "MY_MESSAGING_SENDER_ID"
VITE_FIREBASE_VAPID_KEY: "MY_VAPID_KEY"

# Paste the ENTIRE downloaded service account JSON as a single-line string
# (YAML handles the embedded quotes/commas fine — just keep it all on one line).
FIREBASE_SERVICE_ACCOUNT_KEY: '{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

ALLOW_TEST_AUTH: "false"
CRON_SECRET: "MY_RANDOM_CRON_SECRET"
NODE_ENV: "production"
