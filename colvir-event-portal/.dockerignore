# Зависимости ставятся внутри образа командой npm ci. Без этой строки COPY . .
# затирал бы их локальными: они собраны под другую операционную систему и
# архитектуру, и образ получался нерабочим.
node_modules/

# Секреты и локальные учетные записи не должны попадать в образ
.env
.env.*
!.env.example
dev-directory.json

# Результаты сборки собираются заново внутри образа
dist/
dist-server/
build/
coverage/

# Пользовательские файлы: в образе им не место, для них монтируется том
uploads/

# История и служебное
.git/
.gitignore
*.log
.DS_Store
