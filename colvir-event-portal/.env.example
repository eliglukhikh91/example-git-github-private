# =============================================================================
# Портал корпоративных мероприятий Colvir — пример конфигурации
#
# Скопируйте в .env и заполните реальными значениями.
# .env закоммичен в .gitignore и НИКОГДА не должен попадать в репозиторий.
# =============================================================================

NODE_ENV=production
PORT=3000
PUBLIC_URL=https://events.colvir.com

# -----------------------------------------------------------------------------
# База данных PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://colvir_events:ПАРОЛЬ@db.colvir.com:5432/colvir_events
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Применять миграции при старте сервера. Поставьте false, если схемой
# управляет отдельный шаг CI/CD.
RUN_MIGRATIONS_ON_START=true

# -----------------------------------------------------------------------------
# Секрет подписи сессионных токенов
#
# ОБЯЗАТЕЛЬНО сгенерируйте собственное значение:
#     openssl rand -base64 48
# Сервер откажется стартовать со значением из примера или короче 32 символов.
# -----------------------------------------------------------------------------
JWT_SECRET=

# Время жизни токенов, секунды
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=43200

# -----------------------------------------------------------------------------
# Cookie сессии
#
# COOKIE_SECURE=true требует HTTPS. Оставляйте true в production.
# -----------------------------------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.colvir.com

# -----------------------------------------------------------------------------
# Active Directory / LDAP
#
# Рекомендуется ldaps:// на 636 порту. Незашифрованный ldap:// в production
# отклоняется, если явно не выставлен LDAP_ALLOW_PLAINTEXT=true.
# -----------------------------------------------------------------------------
LDAP_URL=ldaps://dc01.colvir.com:636
LDAP_BIND_DN=CN=svc_events_app,OU=ServiceAccounts,DC=colvir,DC=com
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=DC=colvir,DC=com
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TIMEOUT_MS=8000
# LDAP_ALLOW_PLAINTEXT=false

# Фильтр поиска учётной записи. {{username}} — введённый логин, {{sam}} — часть до @.
LDAP_USER_SEARCH_FILTER=(&(objectClass=user)(|(userPrincipalName={{username}})(sAMAccountName={{sam}})(mail={{username}})))

AD_DOMAIN=COLVIR.COM
AD_ALLOWED_EMAIL_DOMAINS=colvir.com,colvir.ru,colvir.kz

# -----------------------------------------------------------------------------
# Роли на основе групп Active Directory
#
# AD_ADMIN_GROUPS — обязательный параметр. Членство в любой из этих групп даёт
# права администратора портала. Никаких PIN-кодов и списков email в коде нет.
# -----------------------------------------------------------------------------
AD_ADMIN_GROUPS=Colvir-Event-Managers

# Группы, дающие доступ к порталу вообще. Пусто = достаточно успешной
# аутентификации в домене и разрешённого почтового домена.
# AD_REQUIRED_GROUPS=Colvir-Employees

# -----------------------------------------------------------------------------
# Сквозная аутентификация (Kerberos / NTLM) через корпоративный reverse-proxy
#
# ВАЖНО: включайте SSO только если Node недоступен напрямую из сети, а заголовок
# с именем пользователя выставляет исключительно прокси. SSO_TRUSTED_PROXIES —
# адреса самого прокси; запросы с любых других адресов отклоняются с 403.
# -----------------------------------------------------------------------------
SSO_ENABLED=false
SSO_USER_HEADER=x-remote-user
# SSO_TRUSTED_PROXIES=10.10.0.5,10.10.0.6

# -----------------------------------------------------------------------------
# Сеть и безопасность
# -----------------------------------------------------------------------------
# Сколько reverse-proxy стоит перед приложением (для корректных req.ip и rate limit)
TRUST_PROXY_HOPS=1
FORCE_HTTPS=true
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Нужно только если фронтенд обслуживается с другого домена
# CORS_ORIGINS=https://events.colvir.com

# -----------------------------------------------------------------------------
# Вложения чата
#
# Каталог для картинок, которые сотрудники отправляют в чат. Сервер проверяет
# его на старте и не запустится, если каталог недоступен для записи.
#
# Каталог должен быть ВНЕ каталога приложения и переживать переустановку, а при
# нескольких репликах — быть общим для всех (сетевая шара или монтируемый том):
# иначе картинка, загруженная через одну реплику, не откроется через другую.
# -----------------------------------------------------------------------------
UPLOADS_DIR=/var/lib/colvir-events/uploads

# Максимальный размер одного файла в байтах. По умолчанию 20 МБ.
# UPLOAD_MAX_BYTES=20971520

# -----------------------------------------------------------------------------
# Демо-стенд (docker-compose.demo.yml)
#
# SEED_DEMO_DATA=true   — залить демо-мероприятия при старте, если база пустая
# SERVE_BUILT_CLIENT=true — отдавать собранный клиент из dist/ даже вне
#   production-режима: Vite лежит в dev-зависимостях, в образе их нет
# -----------------------------------------------------------------------------
# SEED_DEMO_DATA=false
# SERVE_BUILT_CLIENT=false

# -----------------------------------------------------------------------------
# ТОЛЬКО ДЛЯ ЛОКАЛЬНОЙ РАЗРАБОТКИ
#
# Файловый каталог пользователей вместо контроллера домена. Пароли хранятся
# в виде scrypt-хешей. При NODE_ENV=production сервер откажется стартовать,
# если эта переменная задана.
#
# Создать файл: npm run dev:directory -- ivan.ivanov@colvir.com Пароль123
# -----------------------------------------------------------------------------
# AUTH_DEV_DIRECTORY_FILE=./dev-directory.json
